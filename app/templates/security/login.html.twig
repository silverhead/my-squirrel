{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="min-h-screen bg-base-200 flex items-center justify-center p-4">
    <div class="flex flex-col lg:flex-row w-full max-w-4xl bg-base-100 rounded-box shadow-2xl overflow-hidden">
        <!-- Côté gauche avec l'image -->
        <div class="lg:w-1/2 bg-primary relative">
            <img src="https://placehold.co/400x400" alt="My Squirrel" class="absolute inset-0 w-full h-full object-cover">
        </div>

        <!-- Côté droit avec le formulaire -->
        <div class="lg:w-1/2 p-8">
            <div class="flex flex-col items-center mb-6">
                <h1 class="text-4xl font-bold mb-4">My Squirrel</h1>
                <p class="text-lg opacity-90">Bienvenue sur votre espace personnel</p>
            </div>
            <div class="flex flex-col items-center mb-6">
                <h2 class="text-2xl font-bold text-center">Connexion</h2>
            </div>
            
            <form method="post">
                {# {% if error %}
                    <div class="alert alert-error mb-4">
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %} #}

                <div class="form-control">
                    <input
                        placeholder="Votre e-mail" 
                        type="email" 
                        name="_username" 
                        class="input input-bordered" 
                        required autofocus
                    >
                </div>

                <div class="form-control mt-4">
                    <input 
                        placeholder="Votre mot de passe"
                        type="password" 
                        name="_password" 
                        class="input input-bordered" 
                        required
                    >
                </div>

                <div class="flex items-center justify-between mt-4">
                    <label class="label cursor-pointer">
                        <span class="label-text mr-2">Se souvenir de moi</span>
                        <input type="checkbox" name="_remember_me" class="toggle toggle-primary">
                    </label>
                    {#  {{ path('app_forgot_password_request') }} #}
                    <a href="#" class="link link-primary text-sm">Mot de passe oublié ?</a>
                </div>

                <div class="form-control mt-6">
                    <button class="btn btn-primary w-full">Se connecter</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}