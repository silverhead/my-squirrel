{% extends 'base_connected.html.twig' %}

{% block title %}Tableau de bord bancaire{% endblock %}

{% block body %}
<!-- Contenu principal -->
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Tableau de bord bancaire</h1>
    
    <!-- Widgets de résumé -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="card bg-primary text-primary-content shadow-xl hover:-translate-y-1 transition-transform">
            <div class="card-body">
                <h2 class="card-title">Solde total</h2>
                <p class="text-3xl font-bold">€12,345.67</p>
                <p class="text-sm opacity-80">+2.5% ce mois</p>
            </div>
        </div>
        <div class="card bg-success text-success-content shadow-xl hover:-translate-y-1 transition-transform">
            <div class="card-body">
                <h2 class="card-title">Revenus mensuels</h2>
                <p class="text-3xl font-bold">€3,456.78</p>
                <p class="text-sm opacity-80">+1.2% vs mois dernier</p>
            </div>
        </div>
        <div class="card bg-warning text-warning-content shadow-xl hover:-translate-y-1 transition-transform">
            <div class="card-body">
                <h2 class="card-title">Dépenses mensuelles</h2>
                <p class="text-3xl font-bold">€2,789.12</p>
                <p class="text-sm opacity-80">-0.8% vs mois dernier</p>
            </div>
        </div>
        <div class="card bg-info text-info-content shadow-xl hover:-translate-y-1 transition-transform">
            <div class="card-body">
                <h2 class="card-title">Épargne</h2>
                <p class="text-3xl font-bold">€1,234.56</p>
                <p class="text-sm opacity-80">+5.2% ce mois</p>
            </div>
        </div>
    </div>

    <!-- Graphiques -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">Évolution des dépenses</h2>
                    <div class="h-[300px]">
                        <canvas id="expensesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title">Répartition des dépenses</h2>
                    <div class="h-[300px]">
                        <canvas id="expensesPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Couleurs pour les graphiques
            const colors = {
                primary: '#1e40af',
                secondary: '#4f46e5',
                accent: '#f59e0b',
                neutral: '#6b7280',
                base: '#1f2937'
            };

            // Graphique d'évolution des dépenses
            const expensesCtx = document.getElementById('expensesChart');
            if (expensesCtx) {
                new Chart(expensesCtx, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'],
                        datasets: [{
                            label: 'Dépenses mensuelles',
                            data: [2500, 2800, 2300, 3000, 2789, 3200],
                            borderColor: colors.primary,
                            backgroundColor: `${colors.primary}20`,
                            tension: 0.1,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return '€' + value.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Graphique en camembert des dépenses
            const pieCtx = document.getElementById('expensesPieChart');
            if (pieCtx) {
                new Chart(pieCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Logement', 'Alimentation', 'Transport', 'Loisirs', 'Autres'],
                        datasets: [{
                            data: [40, 20, 15, 15, 10],
                            backgroundColor: [
                                colors.primary,
                                colors.secondary,
                                colors.accent,
                                colors.neutral,
                                colors.base
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
