{% extends 'base_connected.html.twig' %}

{% block title %}Entrées Bancaires{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Entrées Bancaires</h1>
        <div class="flex gap-2">
            <button class="btn btn-primary" onclick="toggleFilterForm()">
                <i class="fas fa-filter"></i> Filtres
            </button>
            <button class="btn btn-secondary">
                <i class="fas fa-file-import"></i> Importer
            </button>
        </div>
    </div>

    {# Formulaire de filtrage avec transition #}
    <div id="filterForm" class="card bg-base-100 shadow-xl mb-8 transition-all duration-300 ease-in-out transform origin-top">
        <div class="card-body">
            <form method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Date début</span>
                    </label>
                    <input type="date" name="start_date" class="input input-bordered" value="{{ app.request.query.get('start_date') }}">
                </div>
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Date fin</span>
                    </label>
                    <input type="date" name="end_date" class="input input-bordered" value="{{ app.request.query.get('end_date') }}">
                </div>
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Montant minimum</span>
                    </label>
                    <input type="number" name="min_amount" class="input input-bordered" value="{{ app.request.query.get('min_amount') }}">
                </div>
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Montant maximum</span>
                    </label>
                    <input type="number" name="max_amount" class="input input-bordered" value="{{ app.request.query.get('max_amount') }}">
                </div>
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Description</span>
                    </label>
                    <input type="text" name="description" class="input input-bordered" value="{{ app.request.query.get('description') }}">
                </div>
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Catégorie</span>
                    </label>
                    <select name="category" class="select select-bordered">
                        <option value="">Toutes les catégories</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if app.request.query.get('category') == category.id %}selected{% endif %}>
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="md:col-span-3 flex justify-end gap-2">
                    {# {{ path('app_bank_entry_index') }} #}
                    <a href="#" class="btn btn-ghost">Réinitialiser</a>
                    <button type="submit" class="btn btn-primary">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    {# Liste des entrées avec animation #}
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Catégorie</th>
                    <th class="text-right">Montant</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr class="transition-all duration-200 hover:bg-base-200">
                        <td>{{ entry.date|date('d/m/Y') }}</td>
                        <td>{{ entry.description }}</td>
                        <td>
                            <div class="badge badge-primary">{{ entry.category.name }}</div>
                        </td>
                        <td class="text-right {% if entry.amount >= 0 %}text-success{% else %}text-error{% endif %}">
                            {{ entry.amount|number_format(2, ',', ' ') }} €
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Aucune entrée trouvée</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    {% if entries.haveToPaginate is defined and entries.haveToPaginate %}
        <div class="flex justify-center mt-8">
            {# {{ knp_pagination_render(entries) }} #}
        </div>
    {% endif %}
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
<script>
function toggleFilterForm() {
    const form = document.getElementById('filterForm');
    if (form.classList.contains('scale-y-0')) {
        form.classList.remove('scale-y-0', 'opacity-0', 'h-0');
        form.classList.add('scale-y-100', 'opacity-100', 'h-auto');
    } else {
        form.classList.remove('scale-y-100', 'opacity-100', 'h-auto');
        form.classList.add('scale-y-0', 'opacity-0', 'h-0');
    }
}

// Initialiser l'état du formulaire
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('filterForm');
    const hasFilters = new URLSearchParams(window.location.search).toString() !== '';
    if (!hasFilters) {
        form.classList.add('scale-y-0', 'opacity-0', 'h-0');
    }
});
</script>
{% endblock %}