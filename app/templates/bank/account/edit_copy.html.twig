{% extends 'base_connected.html.twig' %}

{% block title %}Modifier un compte{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-primary">Modifier un compte bancaire</h1>
        <a href="{{ path('app_bank_account_index') }}" class="btn btn-outline btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Retour
        </a>
    </div>

    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <form action="{{ path('app_bank_account_edit', {'id': id}) }}" method="post" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nom de la banque -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-medium">Nom de la banque</span>
                        </label>
                        <input type="text" name="bank" class="input input-bordered w-full" placeholder="Ex: Caisse d'Épargne" required />
                    </div>

                    <!-- Nom du compte -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-medium">Nom du compte</span>
                        </label>
                        <input type="text" name="name" class="input input-bordered w-full" placeholder="Ex: Compte Courant" required />
                    </div>

                    <!-- Solde -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-medium">Solde</span>
                        </label>
                        <div class="input-group">
                            <input type="number" name="balance" step="0.01" class="input input-bordered w-full" placeholder="0.00" required />
                            <span class="btn btn-square btn-outline">€</span>
                        </div>
                    </div>

                    <!-- Upload de l'icône -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-medium">Icône du compte</span>
                        </label>
                        <div class="flex items-center space-x-2">
                            <label class="btn btn-outline w-full cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span id="file-name">Choisir une image</span>
                                <input type="file" name="icon_file" accept="image/*" class="hidden" id="icon-upload" />
                            </label>
                        </div>
                        <label class="label">
                            <span class="label-text-alt">Formats acceptés: JPG, PNG, SVG (max 2MB)</span>
                        </label>
                    </div>
                </div>

                <!-- Aperçu de l'icône -->
                <div class="form-control w-full">
                    <label class="label">
                        <span class="label-text font-medium">Aperçu de l'icône</span>
                    </label>
                    <div class="flex items-center space-x-4">
                        <div class="avatar placeholder">
                            <div class="bg-neutral-focus text-neutral-content rounded-full w-16 h-16 flex items-center justify-center overflow-hidden" id="icon-preview">
                                <span class="text-xl">?</span>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm text-base-content/70">L'icône sera affichée à côté du nom de votre compte</p>
                        </div>
                    </div>
                </div>

                <!-- Couleur personnalisée -->
                <div class="form-control w-full">
                    <label class="label">
                        <span class="label-text font-medium">Couleur personnalisée</span>
                    </label>
                    <div class="flex items-center space-x-4">
                        <input type="color" name="color" class="input h-12 w-24 p-1 cursor-pointer" value="#6419E6" />
                        <p class="text-sm text-base-content/70">Choisissez une couleur pour personnaliser l'affichage de ce compte</p>
                    </div>
                </div>

                <!-- Options supplémentaires -->
                <div class="form-control">
                    <label class="label cursor-pointer justify-start space-x-3">
                        <input type="checkbox" name="is_favorite" class="checkbox checkbox-primary" />
                        <span class="label-text">Marquer comme compte favori</span>
                    </label>
                </div>

                <div class="form-control">
                    <label class="label cursor-pointer justify-start space-x-3">
                        <input type="checkbox" name="is_hidden" class="checkbox checkbox-primary" />
                        <span class="label-text">Masquer ce compte du tableau de bord principal</span>
                    </label>
                </div>

                <!-- Boutons d'action -->
                <div class="card-actions justify-end pt-4 border-t border-base-300">
                    <button type="reset" class="btn btn-ghost">Réinitialiser</button>
                    <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const iconUpload = document.getElementById('icon-upload');
        const iconPreview = document.getElementById('icon-preview');
        const fileName = document.getElementById('file-name');
        
        // Fonction pour mettre à jour l'aperçu de l'icône
        function updateIconPreview(file) {
            if (file) {
                // Vérifier si le fichier est une image
                if (!file.type.startsWith('image/')) {
                    iconPreview.innerHTML = '<span class="text-xl">!</span>';
                    return;
                }
                
                // Vérifier la taille du fichier (max 2MB)
                if (file.size > 2 * 1024 * 1024) {
                    iconPreview.innerHTML = '<span class="text-xl">!</span>';
                    alert('Le fichier est trop volumineux. Taille maximale: 2MB');
                    return;
                }
                
                // Afficher le nom du fichier
                fileName.textContent = file.name.length > 20 ? file.name.substring(0, 17) + '...' : file.name;
                
                // Créer un objet URL pour l'aperçu
                const reader = new FileReader();
                reader.onload = function(e) {
                    iconPreview.innerHTML = '';
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'w-full h-full object-cover';
                    iconPreview.appendChild(img);
                };
                reader.readAsDataURL(file);
            } else {
                iconPreview.innerHTML = '<span class="text-xl">?</span>';
                fileName.textContent = 'Choisir une image';
            }
        }
        
        // Écouter les changements sur l'input de type fichier
        iconUpload.addEventListener('change', function(e) {
            const file = e.target.files[0];
            updateIconPreview(file);
        });
        
        // Permettre le glisser-déposer sur la zone d'aperçu
        iconPreview.addEventListener('dragover', function(e) {
            e.preventDefault();
            iconPreview.classList.add('ring-2', 'ring-primary');
        });
        
        iconPreview.addEventListener('dragleave', function() {
            iconPreview.classList.remove('ring-2', 'ring-primary');
        });
        
        iconPreview.addEventListener('drop', function(e) {
            e.preventDefault();
            iconPreview.classList.remove('ring-2', 'ring-primary');
            
            if (e.dataTransfer.files.length) {
                iconUpload.files = e.dataTransfer.files;
                updateIconPreview(e.dataTransfer.files[0]);
            }
        });
    });
</script>
{% endblock %}