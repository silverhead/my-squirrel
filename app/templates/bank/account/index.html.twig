{% extends 'base_connected.html.twig' %}

{% block title %}Comptes Bancaires{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8">Mes Comptes Bancaires</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for account in accounts %}
                <div class="card bg-base-100 shadow-xl">
                    <figure class="px-10 pt-10">
                        <img src="{{ account.icon }}" alt="{{ account.bank }}" class="h-24 object-contain"/>
                    </figure>
                    <div class="card-body items-center text-center">
                        <h2 class="card-title">{{ account.bank }}</h2>
                        <p class="text-gray-600">{{ account.name }}</p>
                        <div class="stat-value text-primary">{{ account.balance|number_format(2, ',', ' ') }} €</div>
                        <div class="card-actions justify-end mt-4">
                            <a href="{{ path('app_bank_account_index') }}" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                                </svg>
                                Éditer
                            </a>
                            <a href="{{ path('app_bank_account_index') }}" class="btn btn-secondary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/>
                                </svg>
                                Transactions
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}